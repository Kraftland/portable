#: lib/config/src/definitions/consent.rs:83
msgid "Send notifications"
msgstr "发送桌面通知"

#: lib/config/src/definitions/consent.rs:88
msgid "Inhibit system suspend and shutdown"
msgstr "阻止系统自动睡眠与关机"

#: lib/config/src/definitions/consent.rs:94
msgid "Render on Discrete GPU"
msgstr "使用非默认显卡渲染"

#: lib/config/src/definitions/consent.rs:101
msgid "Run a Kernel Virtual Machine"
msgstr "运行内核虚拟机"

#: lib/config/src/definitions/consent.rs:108
msgid "Access and manage Input Devices"
msgstr "使用并管理输入设备"

#: lib/config/src/definitions/consent.rs:114
msgid "Access Camera"
msgstr "使用相机"

#: lib/config/src/definitions/consent.rs:122
msgid "Mount namespace"
msgstr "挂载命名空间"

#: lib/config/src/definitions/consent.rs:131
msgid "Control Media Players"
msgstr "控制媒体播放"

#: lib/config/src/definitions/consent.rs:139
msgid "Perform debugging"
msgstr "使用调试功能"

#: src/pref/permissions/consent/impls/ask/zenity.rs:74
msgid "This permission may be required for application to function"
msgstr "应用可能需要此权限才能运行"

#: src/pref/permissions/consent/impls/ask/zenity.rs:124
msgid ""
"Would like to request...\n"
"<small>Permissions are persistent and can be revoked by invoking --revoke-"
"permissions</small>"
msgstr ""
"请求以下权限...\n"
"<small>选中权限将被保留，您可以通过 --revoke-permissions 命令行参数撤销</small>"

#: src/pref/permissions/consent/impls/ask/zenity.rs:129
msgid "Allow While in Use"
msgstr "运行时允许"

#: src/pref/permissions/consent/impls/ask/zenity.rs:134
msgid "Permission Description"
msgstr "权限描述"

#: src/pref/runtime/cmdline/help.rs:5
msgid ""
"This is Portable Sandbox. A fast, private, modern sandbox designed for "
"desktop Linux."
msgstr "这是 Portable。一个快速、隐私、现代的 Linux 桌面沙盒。"

#: src/pref/runtime/cmdline/help.rs:8
msgid ""
"Visit https://github.com/Kraftland/portable/blob/master/doc/General/01-cli-"
"arguments.md for CLI documentation"
msgstr ""
"访问 https://github.com/Kraftland/portable/blob/master/doc/General/01-cli-"
"arguments.md 以获取命令行参数帮助。"

#: src/pref/runtime/cmdline/help.rs:11
msgid ""
"You should also receive a copy from the distributor, usually in /usr/share/"
"doc/portable"
msgstr ""
"或访问由发行版打包的帮助文档副本，相关文件通常位于 /usr/share/doc/portable"

#~ msgid "Allow Permission"
#~ msgstr "授予权限"
